# Catppuccin Mocha — match Quickshell's compact, understated popups.
font=sans-serif 9
anchor=top-right
layer=overlay
width=320
height=160
# Clear the 24px Quickshell bar; keep a compact gap between cards.
outer-margin=26,6,6
margin=4
padding=12
border-size=1
border-radius=5

# Same Base, Text and Surface 0 border as Quickshell's audio popup.
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#313244
progress-color=over #45475a88

icons=1
max-icon-size=32
icon-location=left
markup=1
format=<b>%s</b>\n%b
text-alignment=left
max-visible=4
max-history=30
default-timeout=6000
ignore-timeout=0

on-button-left=invoke-default-action
on-button-middle=dismiss-all
on-button-right=dismiss
on-notify=exec pw-play --volume=0.5 --media-role=Notification "${XDG_CONFIG_HOME:-$HOME/.config}/mako/sounds/notification.mp3"

[urgency=low]
text-color=#a6adc8
default-timeout=4000

[urgency=critical]
text-color=#f38ba8
# Critical alerts remain until dismissed, regardless of the sender's timeout.
default-timeout=0
ignore-timeout=1

[hidden]
format=+%h more notifications
text-color=#a6adc8
background-color=#181825
border-color=#313244
on-notify=none

[mode=do-not-disturb]
invisible=1
on-notify=none
